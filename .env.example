# 로컬 개발 환경 설정 예시 — 실행 시 .env가 없으면 scripts/dev-db.mjs가 이 틀로 자동 생성합니다(.env는 git에 올리지 않음).
# NAS DB에는 절대 연결하지 않도록 scripts/dev-db.mjs가 127.0.0.1 / localhost만 허용합니다.
DATABASE_URL=postgres://<OS_USER>@127.0.0.1:5432/terra_dev
BETTER_AUTH_URL=http://localhost:5173
# BETTER_AUTH_SECRET와 DEV_USER_PASSWORD는 처음 생성 시 scripts/dev-db.mjs가 무작위로 채웁니다.
BETTER_AUTH_SECRET=<auto-generated-64-hex>
DEV_USER_PASSWORD=<auto-generated-password>

# 세계 시드·런타임 기본값(ops/compose.yml과 맞춘 결정적 시험 세계)
NPC_SOCIETY=1
NPC_TEST_NATIONS=16
S1_TEST_MAPS=6
S1_TEST_BOTS=100
GARDENER_WAVES=0
