# 의존성·빌드 산출물
node_modules/
dist/
build/
coverage/
*.tsbuildinfo
.vite/
.turbo/
playwright-report/
test-results/

# 비밀값·로컬 설정 (절대 커밋 금지)
.env
.env.*
!.env.example
*.pem
*.key
.claude/settings.local.json

# 로그·임시 파일
*.log
tmp/
.DS_Store
Thumbs.db

# 큰 에셋 원본은 git에 넣지 않는다 (docs/PLAN.md 9.8)
assets-src/

# 생성 파일 (빌드·타입검사 때 다시 만든다)
apps/game/src/paraglide/
# 서버 API 타입 선언 — 게임 앱의 tsc -b가 만든다 (apps/server/tsconfig.api.json)
apps/server/dist-types/
# 1차맵 행성 타일 디스크 캐시(개발 기본 폴더, PLANET_CACHE_DIR) — 지워도 서버가 다시 굽는다
.planet-cache/

# 서브에이전트가 쓰는 임시 작업 트리(git worktree) — 커밋하지 않는다
.claude/worktrees/

# Codex용 로컬 스킬 사본 폴더 — 원본은 .claude/skills/에 있다
.agents/

# 파이썬 캐시 — ui-ux-pro-max 스킬 스크립트(python3)를 돌리면 생긴다
__pycache__/
*.pyc
