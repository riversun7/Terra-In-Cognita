{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // 지원 하한(iOS 16.4)에 맞춰 ES2023까지. 더 새 기능은 기능 확인 뒤에만 쓴다(ADR 2026-10-28-pwa-and-browser-baseline)
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "allowJs": true,
    // vite-plugin-pwa/vanillajs: virtual:pwa-register 모듈 타입
    "types": ["vite/client", "vite-plugin-pwa/vanillajs"]
  },
  "include": ["src", "vite.config.ts"],
  // 서버 API 타입(AppRouter)은 서버 소스가 아니라 이 참조가 만든 선언 파일로 읽는다 → typecheck는 `tsc -b`
  "references": [{ "path": "../server/tsconfig.api.json" }]
}
