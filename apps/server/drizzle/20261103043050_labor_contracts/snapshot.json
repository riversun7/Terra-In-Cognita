      }
    },
    {
      "op": "create",
      "row": {
        "schema": "public",
        "table": "labor_contracts",
        "name": "labor_contracts_end",
        "value": "(\"state\" in ('active', 'paused')) = (\"end_reason\" is null) and (\"state\" = 'grace') = (\"grace_until_ms\" is not null)",
