{
  "name": "@terra/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "vite build",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/migrate.ts"
  },
  "dependencies": {
    "@fastify/static": "10.1.7",
    "@fastify/websocket": "11.3.4",
    "@terra/protocol": "workspace:*",
    "@terra/shared": "workspace:*",
    "drizzle-orm": "1.0.0-rc.5",
    "fastify": "5.12.7",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "@types/ws": "8.18.2",
    "drizzle-kit": "1.0.0-rc.5",
    "tsx": "4.23.15",
    "vite": "8.3.5"
  }
}
