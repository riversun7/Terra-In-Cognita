{
  // 게임 앱이 참조하는 API 타입(d.ts)을 만드는 설정 — TS 프로젝트 참조(composite)
  // 게임 앱의 tsconfig가 이 설정을 references로 가리키고, `tsc -b`가 필요할 때 dist-types/를 다시 만든다.
  // 게임 앱의 타입 검사는 서버 소스 대신 여기서 만든 선언 파일만 읽는다 (ADR 2026-10-28-trpc-type-sharing).
  // composite는 가져오는 파일을 모두 포함해야 해서 src 전체(시험 파일 제외)를 넣는다.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "noEmit": false,
    "emitDeclarationOnly": true,
    "rootDir": "src",
    "outDir": "dist-types",
    "tsBuildInfoFile": "dist-types/.tsbuildinfo"
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts", "src/testFixtures.ts"]
}
