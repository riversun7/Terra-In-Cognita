{
  "name": "terra-in-cognita",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.28.9",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev:server": "pnpm --filter @terra/server dev",
    "dev:game": "pnpm --filter @terra/game dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "oxlint --type-aware --deny-warnings apps packages scripts",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "vitest run",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:size": "node scripts/check-file-size.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "check:content": "node scripts/check-content.mjs",
    "docs:index": "node scripts/build-worklog-index.mjs",
    "changelog": "git-cliff --output CHANGELOG.md",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm check:boundaries && pnpm check:size && pnpm check:i18n && pnpm check:contrast && pnpm check:content --no-compat && pnpm test",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@terra/content": "workspace:*",
    "@types/node": "24.19.2",
    "git-cliff": "2.14.2",
    "lefthook": "2.2.2",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2005",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
