  // 생성기 코드(src/)는 이 설정이 아니라 상위 tsconfig.json으로 검사한다. node로 바로 실행하므로 지울 수 있는 문법만 쓴다.
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    "erasableSyntaxOnly": true
