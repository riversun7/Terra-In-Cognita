{
  // 시뮬레이터 실행 도구 — 파일 읽기·쓰기와 걸린 시간 재기에 Node 타입(fs, process, performance)을 쓴다.
  // 판정 코드(src/)는 이 설정이 아니라 상위 tsconfig.json으로 검사한다. node로 바로 실행하므로 지울 수 있는 문법만 쓴다.
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    "erasableSyntaxOnly": true
